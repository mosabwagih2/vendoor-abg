{
  "name": "vendoor-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch --conditions=react-server scripts/worker.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:web": "next dev",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "worker:once": "tsx --conditions=react-server scripts/worker.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "e2e": "playwright test --trace off",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "tsx prisma/seed/index.ts --reset",
    "postinstall": "prisma generate",
    "figma:check": "tsc -p src/figma/tsconfig.json",
    "figma:publish": "figma connect publish"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-virtual": "^3.14.28",
    "better-auth": "1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-intl": "^4.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@figma/code-connect": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0"
}
