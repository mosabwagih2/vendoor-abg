# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker"
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# 32 bytes base64, encrypts Account access passwords. openssl rand -base64 32
CREDENTIALS_KEY=""
# Signs local file URLs (1 h). openssl rand -base64 32
FILE_URL_SECRET=""

# Storage: "local" (files under ./storage) or "s3"
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email: "console" (prints to the server log) or "resend"
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Vendoor × ABG <tracker@example.com>"
