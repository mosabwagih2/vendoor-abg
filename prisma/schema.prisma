// Vendoor × ABG Work Tracker — data model (PRD section 8, plus additive tables documented in docs/PLAN.md §3 and §10).
// Deletes are soft (archivedAt). All timestamps are stored in UTC (DATETIME(3)); the UI renders Africa/Cairo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// MySQL 8.0.16+ (or MariaDB 10.4+). Lists are JSON arrays (MySQL has no array columns); long text is @db.MediumText
// (TEXT holds only 64 KB: 50,000 Arabic characters or 20,000 emoji would not fit).
// TEXT-type columns cannot take a plain default on MySQL, so their empty-string default is an expression,
// written the way MySQL reports it back (_utf8mb4'') so `prisma migrate diff` sees no drift.
datasource db {
  provider = "mysql"
}

// ───────────────────────────── enums ─────────────────────────────

enum Role {
  owner
  admin
  requester
  abg_lead
  abg_member
}

enum TeamSide {
  requester // Vendoor
  delivery // ABG
}

enum MemberStatus {
  invited
  active
  deactivated
}

enum TaskType {
  bug
  change
  feature
  question
  ops
}

enum TaskStatus {
  triage
  needs_info
  planned
  in_progress
  shipped
  reopened
  done
  closed
}

enum Priority {
  highest
  high
  medium
  low
  lowest
}

enum CloseReason {
  duplicate
  wont_do
  canceled
}

enum HowOften {
  once
  sometimes
  always
}

enum RelationKind {
  related
  blocks
  duplicate_of
}

enum ReleaseType {
  planned
  hotfix
}

enum ReleaseState {
  upcoming // Draft
  released // Live
  rolled_back
}

enum Health {
  on_track
  at_risk
  off_track
}

enum IncidentState {
  investigating
  identified
  monitoring
  resolved
}

enum Channel {
  in_app
  email
  whatsapp
}

enum CommentKind {
  comment
  ask_info
  answer
  reopen_note
  status_request
  close_note
  verify_note
}

enum ProcessingState {
  pending
  ready
  failed
}

enum HolidayCertainty {
  confirmed
  estimated
}

// ───────────────────────────── workspace & calendar ─────────────────────────────

model Workspace {
  id                        String   @id @default(uuid(7))
  name                      String
  timezone                  String   @default("Africa/Cairo")
  workingDays               Json     @default("[6,0,1,2,3,4]") // 0 = Sunday; Saturday to Thursday, Friday off
  workDayStartMin           Int      @default(540) // 09:00
  workDayEndMin             Int      @default(1020) // 17:00
  verifyReminderWorkingDays Int      @default(3)
  unverifiedWorkingDays     Int      @default(7)
  weeklyReportAuto          Boolean  @default(true)
  weeklyReportSentWeek      String? // start key of the last work week that was sent automatically
  slaAtRiskPercentLeft      Int      @default(25)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  teams      Team[]
  projects   Project[]
  holidays   Holiday[]
  seasons    WorkSeason[]
  slaTargets SlaTarget[]
}

model SlaTarget {
  id                   String    @id @default(uuid(7))
  workspaceId          String
  priority             Priority
  firstResponseMinutes Int // working minutes
  resolutionMinutes    Int? // working minutes; null = none
  workspace            Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, priority])
}

model Holiday {
  id          String           @id @default(uuid(7))
  workspaceId String
  date        DateTime         @db.Date
  name        String
  certainty   HolidayCertainty @default(confirmed)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, date])
}

/// Optional period with different working hours (e.g. Ramadan).
model WorkSeason {
  id          String    @id @default(uuid(7))
  workspaceId String
  name        String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  startMin    Int
  endMin      Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Team {
  id          String    @id @default(uuid(7))
  workspaceId String
  name        String
  side        TeamSide
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  members     Member[]

  @@unique([workspaceId, side])
}

// ───────────────────────────── members & auth (Better Auth tables) ─────────────────────────────

/// A person. Also the Better Auth "user" model.
model Member {
  id            String       @id @default(uuid(7))
  name          String
  email         String       @unique @db.VarChar(255)
  emailVerified Boolean      @default(false)
  image         String?      @db.MediumText
  teamId        String
  handle        String       @unique
  role          Role
  status        MemberStatus @default(active)
  locale        String       @default("en")
  theme         String       @default("light")
  lastActiveAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  archivedAt    DateTime?

  team              Team               @relation(fields: [teamId], references: [id])
  sessions          Session[]
  accounts          Account[]
  notificationPrefs NotificationPref[]

  requestedTasks   Task[]             @relation("TaskRequester")
  createdTasks     Task[]             @relation("TaskCreator")
  assignedTasks    Task[]             @relation("TaskAssignee")
  verifiedTasks    Task[]             @relation("TaskVerifier")
  comments         Comment[]
  notifications    Notification[]
  followers        Follower[]
  savedViews       SavedView[]
  occurrences      Occurrence[]
  attachments      Attachment[]
  activity         ActivityEvent[]
  credentials      AccessCredential[]
  releases         Release[]          @relation("ReleaseCreator")
  deployedReleases Release[]          @relation("ReleaseDeployer")
  reactions        Reaction[]
  vendoorLeadOf    Project[]          @relation("VendoorLead")
  abgLeadOf        Project[]          @relation("AbgLead")

  @@map("member")
}

model Session {
  id        String   @id @default(uuid(7))
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(255)
  userAgent String?  @db.MediumText
  userId    String
  user      Member   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String    @db.VarChar(255)
  providerId            String
  userId                String
  user                  Member    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.MediumText
  refreshToken          String?   @db.MediumText
  idToken               String?   @db.MediumText
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.MediumText
  password              String?   @db.MediumText
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String   @db.VarChar(255)
  value      String   @db.MediumText
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model NotificationPref {
  memberId String
  event    String
  inApp    Boolean @default(true)
  email    Boolean @default(true)
  whatsapp Boolean @default(false)
  member   Member  @relation(fields: [memberId], references: [id])

  @@id([memberId, event])
}

model Invitation {
  id          String    @id @default(uuid(7))
  email       String    @db.VarChar(255)
  name        String
  role        Role
  teamId      String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ───────────────────────────── projects ─────────────────────────────

model Project {
  id             String    @id @default(uuid(7))
  workspaceId    String
  key            String    @unique
  name           String
  description    String?   @db.MediumText
  health         Health    @default(on_track)
  vendoorLeadId  String?
  abgLeadId      String?
  nextTaskNumber Int       @default(1)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  vendoorLead Member?           @relation("VendoorLead", fields: [vendoorLeadId], references: [id])
  abgLead     Member?           @relation("AbgLead", fields: [abgLeadId], references: [id])
  categories  ProjectCategory[]
  tasks       Task[]
  updates     ProjectUpdate[]
}

model ProjectCategory {
  id         String    @id @default(uuid(7))
  projectId  String
  name       String
  position   Int
  archivedAt DateTime?
  project    Project   @relation(fields: [projectId], references: [id])
  tasks      Task[]
}

// ───────────────────────────── tasks ─────────────────────────────

/// An extra label inside one of the five steps (Figma 5.1). Tasks keep their internal status; this only changes the name and colour people see.
model CustomStatus {
  id        String   @id @default(uuid(7))
  stepGroup String // request | processing | stuck | completed
  name      String
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  customStatusId    String?
  customStatus      CustomStatus? @relation(fields: [customStatusId], references: [id], onDelete: SetNull)
  id                String        @id @default(uuid(7))
  projectId         String
  number            Int
  key               String        @unique
  title             String        @db.VarChar(500)
  description       String        @default(dbgenerated("(_utf8mb4\\'\\')")) @db.MediumText // Markdown
  type              TaskType
  status            TaskStatus    @default(triage)
  previousStatus    TaskStatus?
  statusChangedAt   DateTime      @default(now())
  priority          Priority?
  suggestedPriority Priority?
  categoryId        String?
  requesterId       String
  createdById       String
  assigneeId        String?
  parentId          String?
  currentReleaseId  String?

  currentBehaviour  String?   @db.MediumText
  expectedBehaviour String?   @db.MediumText
  whyItMatters      String?   @db.MediumText
  howOften          HowOften?
  isOrderRelated    Boolean   @default(false)
  accounts          Json      @default("[]")
  orderCodes        Json      @default("[]")

  decisionText        String?   @db.MediumText
  decisionUpdatedAt   DateTime?
  decisionUpdatedById String?

  dueAt                 DateTime?
  slaClockStartedAt     DateTime     @default(now())
  slaFirstResponseDueAt DateTime?
  slaResolutionDueAt    DateTime?
  firstResponseAt       DateTime?
  shippedAt             DateTime?
  verifyReminderSentAt  DateTime?
  verifiedAt            DateTime?
  verifiedById          String?
  reopenCount           Int          @default(0)
  closeReason           CloseReason?
  closeNote             String?      @db.MediumText
  closedAt              DateTime?
  cancelProposedById    String?
  cancelProposedReason  String?      @db.MediumText
  occurrenceCount       Int          @default(0)
  attachmentCount       Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  archivedAt            DateTime?

  project             Project              @relation(fields: [projectId], references: [id])
  category            ProjectCategory?     @relation(fields: [categoryId], references: [id])
  requester           Member               @relation("TaskRequester", fields: [requesterId], references: [id])
  createdBy           Member               @relation("TaskCreator", fields: [createdById], references: [id])
  assignee            Member?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  verifiedBy          Member?              @relation("TaskVerifier", fields: [verifiedById], references: [id])
  parent              Task?                @relation("Subtasks", fields: [parentId], references: [id])
  subtasks            Task[]               @relation("Subtasks")
  currentRelease      Release?             @relation(fields: [currentReleaseId], references: [id])
  comments            Comment[]
  occurrences         Occurrence[]
  attachments         Attachment[]
  followers           Follower[]
  statusSpans         TaskStatusSpan[]
  releaseTasks        ReleaseTask[]
  relationsFrom       TaskRelation[]       @relation("RelFrom")
  relationsTo         TaskRelation[]       @relation("RelTo")
  credentials         AccessCredential[]
  descriptionVersions DescriptionVersion[]

  @@unique([projectId, number])
  @@index([status])
  @@index([assigneeId, status])
  @@index([requesterId, status])
  @@index([projectId, status])
  @@index([dueAt])
  @@index([updatedAt])
  @@index([parentId])
}

model TaskKeyAlias {
  key    String @id
  taskId String
}

model DescriptionVersion {
  id        String   @id @default(uuid(7))
  taskId    String
  authorId  String
  body      String   @db.MediumText
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])

  @@index([taskId, createdAt])
}

model TaskStatusSpan {
  id        String     @id @default(uuid(7))
  taskId    String
  status    TaskStatus
  enteredAt DateTime
  leftAt    DateTime?
  actorId   String?
  task      Task       @relation(fields: [taskId], references: [id])

  @@index([taskId, enteredAt])
}

model Follower {
  taskId    String
  memberId  String
  following Boolean @default(true)
  source    String
  task      Task    @relation(fields: [taskId], references: [id])
  member    Member  @relation(fields: [memberId], references: [id])

  @@id([taskId, memberId])
}

/// Account access for a task (login the team needs to reproduce or fix).
/// The password is encrypted at rest (AES-256-GCM, key in CREDENTIALS_KEY).
model AccessCredential {
  id                String    @id @default(uuid(7))
  taskId            String
  label             String?   @db.VarChar(255)
  username          String    @db.VarChar(500)
  passwordEncrypted String?   @db.MediumText
  url               String?   @db.MediumText
  note              String?   @db.MediumText
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?
  task              Task      @relation(fields: [taskId], references: [id])
  createdBy         Member    @relation(fields: [createdById], references: [id])

  @@index([taskId])
}

model Occurrence {
  id               String       @id @default(uuid(7))
  taskId           String
  reportedById     String
  accounts         Json         @default("[]")
  orderCodes       Json         @default("[]")
  happenedAt       DateTime
  note             String?      @db.MediumText
  mergedFromTaskId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  archivedAt       DateTime?
  task             Task         @relation(fields: [taskId], references: [id])
  reportedBy       Member       @relation(fields: [reportedById], references: [id])
  attachments      Attachment[]

  @@index([taskId, happenedAt])
}

model Comment {
  id          String       @id @default(uuid(7))
  taskId      String
  authorId    String
  kind        CommentKind  @default(comment)
  body        String       @db.MediumText
  isInternal  Boolean      @default(false)
  editedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?
  task        Task         @relation(fields: [taskId], references: [id])
  author      Member       @relation(fields: [authorId], references: [id])
  reactions   Reaction[]
  attachments Attachment[]

  @@index([taskId, createdAt])
}

model Reaction {
  commentId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])

  @@id([commentId, memberId, emoji])
}

model Attachment {
  id              String          @id @default(uuid(7))
  taskId          String?
  commentId       String?
  occurrenceId    String?
  incidentId      String?
  uploadedById    String
  storageKey      String          @unique @db.VarChar(512)
  playbackKey     String?         @db.VarChar(512)
  posterKey       String?         @db.VarChar(512)
  fileName        String          @db.VarChar(255)
  mime            String          @db.VarChar(255)
  size            BigInt
  durationSec     Float?
  width           Int?
  height          Int?
  waveform        Json?
  processingState ProcessingState @default(pending)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  archivedAt      DateTime?
  task            Task?           @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comment         Comment?        @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  occurrence      Occurrence?     @relation(fields: [occurrenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  incident        Incident?       @relation(fields: [incidentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy      Member          @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@index([occurrenceId])
}

model TaskRelation {
  id          String       @id @default(uuid(7))
  fromTaskId  String
  toTaskId    String
  kind        RelationKind
  createdById String
  createdAt   DateTime     @default(now())
  from        Task         @relation("RelFrom", fields: [fromTaskId], references: [id])
  to          Task         @relation("RelTo", fields: [toTaskId], references: [id])

  @@unique([fromTaskId, toTaskId, kind])
}

// ───────────────────────────── releases ─────────────────────────────

model Release {
  id             String        @id @default(uuid(7))
  number         String        @unique
  state          ReleaseState
  type           ReleaseType
  targetDate     DateTime?
  releasedAt     DateTime?
  notes          String        @default(dbgenerated("(_utf8mb4\\'\\')")) @db.MediumText
  deployedById   String?
  deployNote     String?       @db.MediumText
  rolledBackAt   DateTime?
  rollbackReason String?       @db.MediumText
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?
  createdBy      Member        @relation("ReleaseCreator", fields: [createdById], references: [id])
  deployedBy     Member?       @relation("ReleaseDeployer", fields: [deployedById], references: [id])
  tasks          ReleaseTask[]
  currentFor     Task[]
}

model ReleaseTask {
  releaseId String
  taskId    String
  addedAt   DateTime @default(now())
  release   Release  @relation(fields: [releaseId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])

  @@id([releaseId, taskId])
}

// ───────────────────────────── phase 2 tables (UI later) ─────────────────────────────

model Incident {
  id                 String                  @id @default(uuid(7))
  number             Int                     @unique
  title              String                  @db.VarChar(500)
  scope              String                  @db.MediumText
  state              IncidentState
  startedAt          DateTime
  resolvedAt         DateTime?
  impact             String?                 @db.MediumText
  rootCause          String?                 @db.MediumText
  summary            String?                 @db.MediumText
  resolution         String?                 @db.MediumText
  followUpTaskId     String?
  followUpNoneReason String?                 @db.MediumText
  openedById         String
  closedAt           DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  archivedAt         DateTime?
  timeline           IncidentTimelineEntry[]
  attachments        Attachment[]
}

model IncidentTimelineEntry {
  id         String         @id @default(uuid(7))
  incidentId String
  authorId   String
  state      IncidentState?
  body       String         @db.MediumText
  kind       String         @default("update") // reported | alert_sent | acknowledged | status | update | silence | resolved
  at         DateTime       @default(now())
  incident   Incident       @relation(fields: [incidentId], references: [id])
}

model ProjectUpdate {
  id          String   @id @default(uuid(7))
  projectId   String
  authorId    String
  health      Health
  body        String   @db.MediumText
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id])
}

// ───────────────────────────── activity, notifications, views ─────────────────────────────

model ActivityEvent {
  id            String         @id @default(uuid(7))
  actorId       String?
  subjectType   String
  subjectId     String
  taskId        String?
  verb          String
  field         String?
  fromValue     Json?
  toValue       Json?
  isInternal    Boolean        @default(false)
  meta          Json?
  at            DateTime       @default(now())
  actor         Member?        @relation(fields: [actorId], references: [id])
  notifications Notification[]

  @@index([taskId, at])
  @@index([at])
  @@index([subjectType, subjectId])
}

model Notification {
  id           String        @id @default(uuid(7))
  memberId     String
  eventId      String
  taskId       String?
  kind         String
  channel      Channel
  readAt       DateTime?
  snoozedUntil DateTime?
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  member       Member        @relation(fields: [memberId], references: [id])
  event        ActivityEvent @relation(fields: [eventId], references: [id])

  @@index([memberId, readAt, createdAt])
}

model SavedView {
  id         String    @id @default(uuid(7))
  ownerId    String?
  isShared   Boolean   @default(false)
  name       String
  query      String    @db.MediumText // URL query string of filters + display
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  owner      Member?   @relation(fields: [ownerId], references: [id])
}

/// Simple durable job queue (email, media processing, reminders). Polled by the worker.
model Job {
  id        String    @id @default(uuid(7))
  kind      String
  payload   Json
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lastError String?   @db.MediumText
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}
